#!/bin/bash
# Fake tmux: logs every call; has-session succeeds for names in FAKE_TMUX_SESSIONS
# (space-separated, or one per line when a name itself has a space in it).
echo "tmux $*" >> "${SHIM_LOG:-/dev/null}"
alive() {
  local nl=$'\n'
  case "${FAKE_TMUX_SESSIONS:-}" in
    *"$nl"*) case "$nl${FAKE_TMUX_SESSIONS}$nl" in *"$nl$1$nl"*) return 0 ;; esac ;;
    *)       case " ${FAKE_TMUX_SESSIONS:-} " in *" $1 "*) return 0 ;; esac ;;
  esac
  return 1
}
case "${1:-}" in
  has-session)     alive "$3" && exit 0 || exit 1 ;;
  display-message) echo "${FAKE_TMUX_SESSION:-detached}" ;;
  list-clients)    exit 0 ;;
  list-panes)      echo "${FAKE_TMUX_COMMAND:-zsh}" ;;   # what runs in the pane: zsh, or claude
  send-keys)
    # FAKE_TMUX_ANSWER=<file>: play the agent answering fleet move's handoff
    # request: a done state file whose handoff is that file's text, as the
    # hook writes it while the request is pending. FAKE_TMUX_ANSWER_RUN runs
    # first: the agent doing something it was told not to. FAKE_TMUX_ANSWER=
    # blocked: the agent asks for permission instead.
    case "$*" in *"handoff note"*)
      if [ "${FAKE_TMUX_ANSWER:-}" = blocked ]; then
        jq -n --arg p "${5:-}" --argjson ts "$(date +%s)" '{state: "blocked", ts: $ts, prompt: $p[:400]}' > "$FLEET_STATE/$3.json"
      elif [ -n "${FAKE_TMUX_ANSWER:-}" ]; then
        [ -z "${FAKE_TMUX_ANSWER_RUN:-}" ] || sh -c "$FAKE_TMUX_ANSWER_RUN"
        # The hook recorded the typed request as the turn's prompt, unless
        # FAKE_TMUX_ANSWER_STALE: a turn that answered something else.
        p="${5:-}"; [ -z "${FAKE_TMUX_ANSWER_STALE:-}" ] || p="something else"
        jq -n --rawfile h "$FAKE_TMUX_ANSWER" --arg p "${p:0:400}" --argjson ts "$(date +%s)" \
          '{state: "done", ts: $ts, prompt: $p, said: $h[:800], handoff: $h}' > "$FLEET_STATE/$3.json"
      fi ;;
    esac ;;
esac
exit 0
